
### ============================================
### CUSTOMERS + ORDERS
### Testit suoritetaan järjestyksessä.
### Vaatii ADMIN-tunnukset.
### Vain testitietokantaan.
### ============================================

### 1. Luo testiasiakas
POST http://localhost:8081/customers
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "firstName": "HTTP",
  "lastName": "OrderTest",
  "email": "order-{{$timestamp}}@example.test",
  "phone": "0401234567"
}

> {%
    client.test("Customer POST: 201 ja ID", function () {
        client.assert(response.status === 201, "Expected 201");
        client.assert(response.body.id > 0, "Missing customer ID");
    });
    if (response.status === 201) {
        client.global.set("auditCustomerId", String(response.body.id));
    }
%}

### 2. Virheellinen asiakkaan luonti
POST http://localhost:8081/customers
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Test",
  "email": ""
}

> {%
    client.test("Customer validation: 400", function () {
        client.assert(response.status === 400, "Expected 400");
    });
%}

### 3. Luo tilaus uudelle asiakkaalle
POST http://localhost:8081/orders
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "customerId": {{auditCustomerId}},
  "deliveryDate": "2026-11-01T12:00:00",
  "shippingAddressId": null,
  "status": "NEW"
}

> {%
    client.test("Order POST: 201 ja NEW", function () {
        client.assert(response.status === 201, "Expected 201");
        client.assert(response.body.id > 0, "Missing order ID");
        client.assert(response.body.status === "NEW", "Incorrect status");
    });
    if (response.status === 201) {
        client.global.set("auditOrderId", String(response.body.id));
    }
%}

### 4. Hae tilaukset sivutettuna
GET http://localhost:8081/orders?page=0&size=5
Authorization: Basic admin admin_api_password

> {%
    client.test("GET orders: Page", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.content), "Missing content");
        client.assert(response.body.content.length <= 5, "Invalid page size");
    });
%}

### 5. Suodata tilaukset statuksella
GET http://localhost:8081/orders?status=NEW&page=0&size=10
Authorization: Basic admin admin_api_password

> {%
    client.test("Status filter: NEW", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.content.every(x => x.status === "NEW"),
            "Incorrect status filter");
    });
%}

### 6. Suodata asiakkaan ID:llä
GET http://localhost:8081/orders?customerId={{auditCustomerId}}&page=0&size=10
Authorization: Basic admin admin_api_password

> {%
    client.test("Customer filter", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.content.some(
            x => String(x.id) === String(client.global.get("auditOrderId"))
        ), "Created order missing");
    });
%}

### 7. Suodata asiakkaalla ja statuksella
GET http://localhost:8081/orders?customerId={{auditCustomerId}}&status=NEW&page=0&size=10
Authorization: Basic admin admin_api_password

> {%
    client.test("Combined filters", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.content.length >= 1, "No matching orders");
        client.assert(response.body.content.every(x => x.status === "NEW"),
            "Incorrect status");
    });
%}

### 8. Asiakkaan omat tilaukset
GET http://localhost:8081/customers/{{auditCustomerId}}/orders?page=0&size=10
Authorization: Basic admin admin_api_password

> {%
    client.test("Customer orders", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.content.length >= 1, "Order missing");
    });
%}

### 9. Hae tilaus ID:llä
GET http://localhost:8081/orders/{{auditOrderId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Order GET by ID", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(String(response.body.id) ===
            String(client.global.get("auditOrderId")), "Wrong order");
    });
%}

### 10. Uuden tilauksen tilausrivit
GET http://localhost:8081/orders/{{auditOrderId}}/items
Authorization: Basic admin admin_api_password

> {%
    client.test("New order has no items", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
        client.assert(response.body.length === 0, "Expected empty order");
    });
%}

### 11. Päivitä tilaus
PUT http://localhost:8081/orders/{{auditOrderId}}
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "customerId": {{auditCustomerId}},
  "deliveryDate": "2026-11-05T14:00:00",
  "shippingAddressId": null,
  "status": "NEW"
}

> {%
    client.test("Order PUT: 200", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.deliveryDate.startsWith("2026-11-05"),
            "Delivery date not updated");
    });
%}

### 12. Päivitä tilauksen status
PATCH http://localhost:8081/orders/{{auditOrderId}}/status
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "status": "PROCESSING"
}

> {%
    client.test("Order PATCH: PROCESSING", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.status === "PROCESSING",
            "Status was not updated");
    });
%}

### 13. Varmista päivitetty status
GET http://localhost:8081/orders/{{auditOrderId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Updated status persisted", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.status === "PROCESSING",
            "Status not persisted");
    });
%}

### 14. Temporaalinen historia päivitysten jälkeen
GET http://localhost:8081/orders/{{auditOrderId}}/history
Authorization: Basic admin admin_api_password

> {%
    client.test("Order history includes versions", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
        client.assert(response.body.length >= 2, "No previous version found");
    });
%}

### 15. Peruutus estetään nykyisessä toteutuksessa
PATCH http://localhost:8081/orders/{{auditOrderId}}/status
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "status": "CANCELLED"
}

> {%
    client.test("Cancellation blocked: 409", function () {
        client.assert(response.status === 409, "Expected 409");
    });
%}

### 16. Olematon tilaus
GET http://localhost:8081/orders/999999999
Authorization: Basic admin admin_api_password

> {%
    client.test("Missing order: 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}

