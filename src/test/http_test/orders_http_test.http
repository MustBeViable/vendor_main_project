GET http://localhost:8081/orders?page=0&size=101
Authorization: Basic admin admin_api_password

> {%
    client.test("Invalid page size: 400", function () {
        client.assert(response.status === 400, "Expected 400");
    });
%}

### 19. Olemattoman asiakkaan tilaukset
GET http://localhost:8081/customers/999999999/orders
Authorization: Basic admin admin_api_password

> {%
    client.test("Missing customer: 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}

### 20. Tilaus olemattomalle asiakkaalle
POST http://localhost:8081/orders
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "customerId": 999999999,
  "deliveryDate": null,
  "shippingAddressId": null,
  "status": "NEW"
}

> {%
    client.test("Missing customer on order creation: 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}

### 21. Poista luotu tyhjä tilaus
DELETE http://localhost:8081/orders/{{auditOrderId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Order DELETE: 204", function () {
        client.assert(response.status === 204, "Expected 204");
    });
%}

### 22. Varmista, että tilaus poistui
GET http://localhost:8081/orders/{{auditOrderId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Deleted order: 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}
