
### ============================================
### TEMPORAL HISTORY
### Orders + Products
### Ei muuta tietokantaa.
### ============================================

### 1. Hae tilauksen 3 kaikki versiot
GET http://localhost:8081/orders/3/history
Authorization: Basic admin admin_api_password

> {%
    client.test("Order history: 200", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
        client.assert(response.body.length > 0, "History missing");
        client.assert(response.body.every(x => x.id === 3), "Wrong order");
        client.assert(response.body[0].versionStart != null,
            "Missing versionStart");
    });
    if (response.status === 200 && response.body.length > 0) {
        client.global.set("orderAsOf",
            String(response.body[0].versionStart));
    }
%}

### 2. Hae tilauksen 3 tila AS OF -kyselyllä
GET http://localhost:8081/orders/3/history?asOf={{orderAsOf}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Order history AS OF", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
        client.assert(response.body.length === 1,
            "Expected exactly one version");
        client.assert(response.body[0].id === 3, "Wrong order");
    });
%}

### 3. Hae tuotteen 7 kaikki versiot
GET http://localhost:8081/products/7/history
Authorization: Basic admin admin_api_password

> {%
    client.test("Product history: 200", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
        client.assert(response.body.length > 0, "History missing");
        client.assert(response.body.every(x => x.id === 7),
            "Wrong product");
        client.assert(response.body[0].versionStart != null,
            "Missing versionStart");
    });
    if (response.status === 200 && response.body.length > 0) {
        client.global.set("productAsOf",
            String(response.body[0].versionStart));
    }
%}

### 4. Hae tuotteen tila AS OF -kyselyllä
GET http://localhost:8081/products/7/history?asOf={{productAsOf}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Product history AS OF", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body), "Expected array");
