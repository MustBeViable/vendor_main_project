### 11. Luo tilaus käyttämään testiosoitetta
POST http://localhost:8081/orders
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "customerId": 51914,
  "deliveryDate": null,
  "shippingAddressId": {{testCustomerAddressId}},
  "status": "NEW"
}

> {%
    client.test("Order with address created: 201", function () {
        client.assert(response.status === 201, "Expected 201");
        client.assert(response.body.id > 0, "Missing order ID");
        client.assert(response.body.shippingAddressId ===
            Number(client.global.get("testCustomerAddressId")),
            "Shipping address not linked");
    });

    if (response.status === 201) {
        client.global.set("testCustomerAddressOrderId",
            String(response.body.id));
    }
%}

### 12. Tilauksessa käytetyn osoitteen poisto estetään
DELETE http://localhost:8081/customeraddresses/{{testCustomerAddressId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Address in use: 409", function () {
        client.assert(response.status === 409, "Expected 409");
    });
%}

### 13. Käytössä olevaa osoitetta ei saa siirtää toiselle asiakkaalle
PUT http://localhost:8081/customeraddresses/{{testCustomerAddressId}}
Authorization: Basic admin admin_api_password
Content-Type: application/json

{
  "customerId": 1,
  "streetAddress": "Transfer Test Street",
  "postalCode": "00100",
  "city": "Helsinki",
  "country": "Finland"
}

> {%
    client.test("Address customer change blocked: 409", function () {
        client.assert(response.status === 409, "Expected 409");
    });
%}

### 14. Varmista osoitteen alkuperäinen asiakas
GET http://localhost:8081/customeraddresses/{{testCustomerAddressId}}
Authorization: Basic admin admin_api_password

> {%
    client.test("Address owner unchanged", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.customerId === 51914,
            "Address owner changed unexpectedly");
    });
%}

