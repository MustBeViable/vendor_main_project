### 6. DAILY_ORDER_COUNT - historialliset tilastot
GET http://localhost:8081/reports/daily-order-count?from=2025-10-17&to=2025-11-05&page=0&size=20
Authorization: Basic admin admin_api_password

> {%
    client.test("Daily order count history", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(Array.isArray(response.body.content), "Expected Page");
        client.assert(response.body.content.length === 20,
            "Expected 20 dates");

        const row = response.body.content.find(
            x => x.date === "2025-11-05"
        );
        client.assert(row !== undefined, "Missing 2025-11-05");
        client.assert(row.orderCount === 178, "Expected 178 orders");
    });
%}

### 7. DAILY_ORDER_COUNT - seuraava sivu
GET http://localhost:8081/reports/daily-order-count?from=2025-01-01&to=2025-12-31&page=1&size=20
Authorization: Basic admin admin_api_password

> {%
    client.test("Daily statistics pagination", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.number === 1, "Expected page 1");
        client.assert(response.body.content.length <= 20,
            "Invalid page size");
    });
%}

### 8. DAILY_ORDER_COUNT - tuleva tyhjä aikaväli
GET http://localhost:8081/reports/daily-order-count?from=2030-01-01&to=2030-01-31
Authorization: Basic admin admin_api_password

> {%
    client.test("Empty date range returns 200", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.content.length === 0,
            "Expected no rows");
    });
%}

